# EditorConfig is awesome: https://EditorConfig.org

root = true

[justfile]
indent_style = space
indent_size = 2

[*.{md,sh,yml,yaml,json,jsonc}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
